#!/usr/bin/env bash
# Prints the UDID of the newest available "iPhone <n> Pro" simulator on the newest iOS runtime.
# Override with SIMULATOR_UDID.
set -euo pipefail
if [ -n "${SIMULATOR_UDID:-}" ]; then echo "$SIMULATOR_UDID"; exit 0; fi
xcrun simctl list devices available -j | jq -r '
  .devices | to_entries
  | map(select(.key | test("iOS")))
  | sort_by(.key | capture("iOS-(?<v>[0-9-]+)").v | split("-") | map(tonumber))
  | reverse | .[0].value
  | map(select(.name | test("^iPhone [0-9]+ Pro$")))
  | sort_by(.name | capture("iPhone (?<n>[0-9]+)").n | tonumber)
  | last | .udid // empty' | grep . || { echo "no iPhone Pro simulator found" >&2; exit 1; }
